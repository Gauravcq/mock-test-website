{
  "rewrites": [
    { "source": "/admin/payments.html", "destination": "/admin-payments.html" },
    { "source": "/admin/payments", "destination": "/admin-payments.html" },
    { "source": "/payments", "destination": "/admin-payments.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}